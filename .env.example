# Mot de passe unique d'accès à l'app. Obligatoire en production.
BARDA_PASSWORD=

# Clé de signature du cookie de session. Obligatoire en production.
# Génère-la avec : openssl rand -hex 32
BARDA_SECRET=

# Jeton du relais d'impression Mac (en-tête x-barda-token). Optionnel.
BARDA_PRINT_TOKEN=

# Jeton du serveur MCP (Authorization: Bearer …). Sans lui, /api/mcp refuse tout.
BARDA_MCP_TOKEN=

# Optionnel : suggestions de photos Unsplash (clé gratuite sur unsplash.com/developers).
UNSPLASH_ACCESS_KEY=

# Mode démo public : données fictives, lecture seule, pas de mot de passe.
# BARDA_DEMO=1

# Signature en pied de page : vide = « Conçu par can.sys », off = aucune.
# BARDA_SIGNATURE=

# Derrière Cloudflare Access : nom de l'équipe (xxx.cloudflareaccess.com) et « aud » de
# l'application. Toute requête sans jeton Access valide est alors refusée (sauf MCP et relais).
# BARDA_CF_ACCESS_TEAM=
# BARDA_CF_ACCESS_AUD=
